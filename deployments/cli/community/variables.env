# Khelo / JIST Nest deploy env — no Django / Gunicorn / Celery / RabbitMQ
APP_DOMAIN=localhost
APP_RELEASE=latest

WEB_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

WEB_URL=http://${APP_DOMAIN}
ADMIN_BASE_URL=http://${APP_DOMAIN}/admin
CORS_ALLOWED_ORIGINS=http://${APP_DOMAIN}
CORS_ORIGINS=http://${APP_DOMAIN}
API_BASE_URL=http://api:8000

# Postgres
PGHOST=plane-db
PGDATABASE=khelo
POSTGRES_USER=khelo
POSTGRES_PASSWORD=khelo
POSTGRES_DB=khelo
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://khelo:khelo@plane-db:5432/khelo

# Nest session (openssl rand -hex 32)
SESSION_SECRET=change-me-khelo-session-secret
NODE_ENV=production
PORT=8000

# Redis (optional cache)
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# MinIO / S3
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880

# Proxy / TLS
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0

# Path to Nest backend repo when building locally (sibling of plane-frontend)
PLANE_BACKEND_PATH=../../../../plane-backend

# Optional image overrides
# API_IMAGE=khelo-tech/plane-backend
# WEB_IMAGE=khelo-tech/plane-frontend
